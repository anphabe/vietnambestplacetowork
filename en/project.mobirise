              "padding-left": "1rem",
              "padding-right": "1rem",
              "background-color": "#093d5a",
              "min-height": "10vh"
            },
            ".plan-title": {
              "color": "#ffffff"
            },
            ".plan .list-group-item": {
              "position": "relative",
              "justify-content": "center",
              "border": "0",
              "padding": "1.5rem 1rem"
            },
            ".plan .list-group-item::after": {
              "position": "absolute",
              "bottom": "1px",
              "left": "25%",
              "width": "50%",
              "height": "1px",
              "content": "\"\"",
              "background-color": "rgba(0, 0, 0, 0.1)"
