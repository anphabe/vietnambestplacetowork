          "_name": "menu1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3.8\" max=\"8\" step=\"0.1\" value=\"3.8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#000000\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n\n\n         <div class=\"navbar-unity\">\n          <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n              <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                  <a class=\"iconfont-wrapper\" href=\"https://www.facebook.com/vietnam100bestplacestowork\" target=\"_blank\">\n                      <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\" style=\"font-size: 13px; color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                  </a>\n                  <a class=\"iconfont-wrapper\" href=\"https://www.linkedin.com/company/anphabe.com/\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                      <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\" style=\"font-size: 13px; color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                  </a>\n                  <a class=\"iconfont-wrapper\" href=\"https://www.youtube.com/anphabevideo\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                      <span mbr-icon class=\"p-2 mbr-iconfont socicon-youtube socicon\" style=\"font-size: 13px; color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                  </a>\n                  <a class=\"iconfont-wrapper\" href=\"https://twitter.com/anphabe\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                      <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\" style=\"font-size: 13px; color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                  </a>\n              </div>\n              <div class=\"menu-contact justify-content-end align-items-start flex-grow-1 d-flex\">\n                  \n                    <div> <a class=\"nav-link link text-secondary display-7\" href=\"mailto:clientsolution@anphabe.com\"><span mbr-icon class=\"mbr-iconfont socicon-mail socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255); font-size: 13px;\"></span><span class=\"d-none d-lg-inline-block\">clientsolution@anphabe.com</span></a> </div> \n                      <div><a class=\"nav-link link text-secondary display-7\" href=\"tel:+842862682222\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"font-size: 13px; color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span><span class=\"d-none d-lg-inline-block\">(+84) 28 6268 2222</span></a></div>\n                  \n                    <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"d-none d-md-inline-block navbar-buttons mbr-section-btn\"><a class=\"btn btn-warning\" href=\"contact.html\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 12px;\"></span>\n                            <span>CONTACT</span></a></div>\n              </div>\n          </div>      \n        </div>             \n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/vietnambestplacestowork-logo-94x60.png\" alt=\"Vietnam Best Places To Work\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Vietnam Best Places To Work</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item dropdown\"><a class=\"nav-link link text-white text-primary dropdown-toggle show\" href=\"index.html#gioi-thieu\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">ABOUT AWARDS</a><div class=\"dropdown-menu show\" aria-labelledby=\"dropdown-288\" data-bs-popper=\"none\"><a class=\"text-white text-primary dropdown-item\" href=\"index.html#gioi-thieu\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Survey Method</a><a class=\"text-white text-primary dropdown-item\" href=\"index.html#gioi-thieu\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">FAQs</a></div></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"contact.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">CONTACT</a></li></ul>\n                \n            </div>\n        </div>\n    </nav>\n\n</section>",
