            },
            ".mbr-section-title": {
              "color": "#232323"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".item-title": {
              "text-align": "left",
              "color": "#ffffff",
              "font-size": "30px !important"
            },
            ".item-subtitle": {
              "text-align": "left",
              "color": "#232323"
            },
            ".item li": {
              "padding-bottom": "10px"
            }
