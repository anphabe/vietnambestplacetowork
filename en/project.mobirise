              "font-size": "20px",
              "border-radius": "50%",
              "width": "35px",
              "height": "35px",
              "line-height": "35px",
              "text-align": "center",
              "transition": "all 0.3s ease-in-out"
            },
            "& when (@squareIcons)": {
              ".iconfont-wrapper": {
                "border-radius": "0 !important"
              }
            },
            "[class^=\"socicon-\"]:before, [class*=\" socicon-\"]:before": {
              "line-height": "35px",
              "padding": ".4rem"
            },
