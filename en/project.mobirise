              "background-color": "#0b6c8a !important",
              "border-color": "#0b6c8a !important",
              "box-shadow": "0 2px 5px 0 rgba(0, 0, 0, 0.2)"
            },
            ".btn-success.disabled, .btn-success:disabled": {
