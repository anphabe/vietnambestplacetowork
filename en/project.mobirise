          "_name": "form1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form1\" group=\"Forms\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg-cover-1440x774.png\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-lg-8 mx-auto mbr-form\">\n\n                  <form class=\"mbr-form anphabe-lead form-with-styler  needs-validation mt-5 pt-5\" novalidate data-form-type=\"anphabe-lead\" name=\"lien-he-VNBPTW\" id=\"lien_he\" method=\"POST\">      \n                                  <input type=\"hidden\" id=\"product_name-form7-44\" name=\"product_name\" data-form-field=\"product_name\" value=\"VNBPTW\">\n                                  <input type=\"hidden\" name=\"landingpage\" value=\"VNBPTW\">\n                    <input type=\"hidden\" id=\"utm_campaign-form7-44\" name=\"utm_campaign\" data-form-field=\"utm_campaign\" value>\n                    <input type=\"hidden\" id=\"utm_source-form7-44\" name=\"utm_source\" data-form-field=\"utm_source\" value>\n                    <input type=\"hidden\" id=\"utm_medium-form7-44\" name=\"utm_medium\" data-form-field=\"utm_medium\" value>\n                    <input type=\"hidden\" id=\"utm_term-form7-44\" name=\"utm_term\" data-form-field=\"utm_term\" value>\n                    <input type=\"hidden\" id=\"utm_content-form7-44\" name=\"utm_content\" data-form-field=\"utm_content\" value>\n                    <a id=\"destination\" href=\"thankyou.html\" style=\"display:none;\"></a>\n                                  <div class=\"dragArea row\">\n                                      <div class=\"col-12\" mbr-if=\"showTitle\">\n                                          <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-4 mt-2 pt-2 mt-md-5 pt-md-5\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">REGISTER TO BECOME A PRESTIGIOUS CANDIDATE OF VIETNAM BEST PLACES TO WORK<sup>®</sup></h4>\n                                      </div>\n                                      <div class=\"col-12\">\n                                          <p mbr-theme-style=\"display-7\" class=\"mbr-text mbr-fonts-style mb-5\" mbr-if=\"showText\">Contact:&nbsp; <a href=\"tel:+842862682222\" class=\"text-secondary\">(+84) 28 6268 2222</a><br>\nEmail:&nbsp;<a href=\"mailto:clientsolution@anphabe.com\" class=\"text-secondary\">clientsolution@anphabe.com</a></p>\n                                      </div>\n\n                                      <div class=\"col-sm-12 form-group mb-3\" data-for=\"name\">\n                                          <input type=\"text\" name=\"fullname\" placeholder=\"Your name\" data-form-field=\"fullname\" class=\"form-control\" value required>\n                                            <div class=\"invalid-feedback text-start  mbr-fonts-style\">Please enter your name</div>\n                                      </div>\n                                      <div class=\"col-md col-sm-12 form-group mb-3\" data-for=\"phone\">\n                                          <input type=\"text\" name=\"phone\" placeholder=\"Phone number\" data-form-field=\"phone\" class=\"form-control\" value required>\n                                          <div class=\"invalid-feedback text-start mbr-fonts-style\">Please enter your phone number</div>\n                                      </div>\n                                      <div class=\"col-md col-sm-12 form-group mb-3\" data-for=\"email\">\n                                          <input type=\"email\" name=\"email\" placeholder=\"E-mail liên lạc\" data-form-field=\"email\" class=\"form-control\" value required>\n                                          <div class=\"invalid-feedback text-start mbr-fonts-style\">Please enter your email</div>\n                                      </div>\n                                      <div class=\"col-sm-12 form-group mb-3\" data-for=\"position\">\n                                          <input type=\"text\" name=\"position\" placeholder=\"Position\" data-form-field=\"position\" class=\"form-control\" value required>\n                                          <div class=\"invalid-feedback text-start mbr-fonts-style\">Please enter your position</div>\n                                      </div>\n                                      <div class=\"col-sm-12 form-group mb-3\" data-for=\"companyname\">\n                                          <input type=\"text\" name=\"companyname\" placeholder=\"Company name\" data-form-field=\"companyname\" class=\"form-control\" value required>\n                                          <div class=\"invalid-feedback text-start mbr-fonts-style\">Please enter your Company name</div>\n                                      </div>\n                                      <div class=\"col-sm-12 form-group mb-3\" data-for=\"company-size\">\n                                        <select class=\"form-control\" title=\"company-size\" name=\"company-size\" data-form-field=\"company-size\" required>\n                                          <option value selected>-- Company size --</option>\n                                        <option value=\"1-50 nhân sự\">1-60 employees</option>\n                                        <option value=\"51-200 nhân sự\">61-200 employees</option>\n                                        <option value=\"201-500 nhân sự\">201-500 employees</option>\n                                        <option value=\"501-1000 nhân sự\">501-1000 employees</option>\n                                        <option value=\"Hơn 1000 nhân sự\">Hơn 1000 employees</option>\n                                        </select>\n                                        <div class=\"invalid-feedback text-start mbr-fonts-style\">Please select your company size</div>\n                                      </div>\n            \n                                      <div class=\"col-12 form-group mb-3\" data-for=\"nhucautuvan-detail\">\n                                          <textarea name=\"nhucautuvan-detail\" data-form-field=\"nhucautuvan-detail\" placeholder=\"Please describe your consulting needs!\" class=\"form-control\"></textarea>\n                                      </div>\n                                      <div mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-lg-12 col-md-12 col-sm-12 align-center mbr-section-btn display-4\"><button type=\"submit\" class=\"btn btn-warning click-tracking\" data-tracking-action=\"gui-thong-tin\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 12px;\"></span>SUBMIT</button></div>\n                                  </div>\n                              </form>\n\n\n\n\n            </div>\n        </div>\n    </div>\n    <div class=\"d-none\">\n        [JS_CODE_0]\n    </div>\n</section>",
          "_JSplaceholders": [
            "<script type=\"text/javascript\" src=\"https://mau.anphabe-update.com/form/generate.js?id=1\"></script>"
          ],
