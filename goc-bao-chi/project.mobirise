        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "img, .item-img": {
              "& when (@autoSize)": {
                "height": "100%",
                "object-fit": "cover",
                "& when (@showCardTitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showCardSubtitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showText)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showButtons)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "cursor": "pointer",
              "margin-bottom": "2rem"
            },
            "& when not (@spacing)": {
              ".row": {
                "margin-left": "0",
                "margin-right": "0"
              },
              ".item": {
                "padding": "0",
                "margin": "0"
              }
            },
            ".item-wrapper": {
              "position": "relative",
              "border-radius": "4px",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap",
              "@media (min-width: 992px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem 2rem 0"
                  },
                  ".item-footer": {
                    "padding": "0 2rem 2rem"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem"
                  }
                }
              },
              "@media (max-width: 991px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem 1rem 0"
                  },
                  ".item-footer": {
                    "padding": "0 1rem 1rem"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem"
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important"
            },
            ".mbr-section-title": {
              "color": "#232323"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left"
            },
            ".item-title": {
              "text-align": "left"
            },
            ".item-subtitle": {
              "text-align": "left",
              "color": "#087096"
            },
            ".btn": {
              "padding": "0.2rem 0",
              "font-weight": "700"
            },
            "a.btn": {
              "position": "relative",
              "color": "#087096",
              "text-decoration": "none"
            },
            "a.btn::after": {
              "content": "''",
              "position": "absolute",
              "width": "100%",
              "height": "1px",
              "bottom": "0",
              "left": "0",
              "color": "#087096",
              "background-color": "#087096",
              "transform": "scaleX(0)",
              "transform-origin": "bottom right",
              "transition": "transform 0.3s ease-out"
            },
            "a:hover::after": {
              "transform": "scaleX(1)",
              "transform-origin": "bottom left"
            },
            "a.title-link, a.title-link:hover, a.title-link:visited, a.title-link::after": {
              "color": "#232323!important",
              "transition": "none!important",
              "text-decoration": "none!important",
              "background-size": "0 !important"
            }
          },
          "_name": "content2",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content2\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <select title=\"Columns\" name=\"cardsWidth\">\n            <option value=\"12\">1</option>\n            <option value=\"6\">2</option>\n            <option value=\"4\" selected>3</option>\n            <option value=\"3\">4</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\">\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"2\" condition=\"autoSize && !(showButtons==false && showCardSubtitle==false && showCardTitle==false && showText==false)\">\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Subtitle\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked>\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#fafafa\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">        \n        <div class=\"row mt-4\">\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}} active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://vnexpress.net/100-noi-lam-viec-tot-nhat-viet-nam-2025-4966748.html\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-301.jpg\" alt title data-slide-to=\"0\" data-bs-slide-to=\"0\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://vnexpress.net/100-noi-lam-viec-tot-nhat-viet-nam-2025-4966748.html\" class=\"text-primary title-link\" target=\"_blank\"><b>100 Nơi Làm Việc Tốt Nhất Việt Nam năm 2025</b></a></h5>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"https://vnexpress.net/100-noi-lam-viec-tot-nhat-viet-nam-2025-4966748.html\" class=\"text-primary\" target=\"_blank\"><i>https://vnexpress.net/</i></a></h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">Bảng xếp hạng 2025 nổi bật với nhiều doanh nghiệp thăng hạng, loạt gương mặt mới như KienlongBank, Duy Tân Recycling và lần đầu mở rộng khảo sát sang 7.000 sinh viên.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://vnexpress.net/100-noi-lam-viec-tot-nhat-viet-nam-2025-4966748.html\" class=\"btn item-btn btn-success-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">Xem thêm <span class=\"mbrib-right mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 14px;\"></span></a></div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://tphcm.chinhphu.vn/cong-bo-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-101251120085426125.htm\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-32.jpg\" alt title data-slide-to=\"1\" data-bs-slide-to=\"1\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://tphcm.chinhphu.vn/cong-bo-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-101251120085426125.htm\" class=\"text-primary title-link\" target=\"_blank\"><b>Công bố 100 Nơi làm việc tốt nhất Việt Nam năm 2025</b></a></h5>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"https://tphcm.chinhphu.vn/cong-bo-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-101251120085426125.htm\" class=\"text-primary\" target=\"_blank\"><i>https://tphcm.chinhphu.vn/</i></a></h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">(Chinhphu.vn) - Tối 19/11, Anphabe (đơn vị tư vấn tiên phong về giải pháp thương hiệu nhà tuyển dụng và môi trường làm việc hạnh phúc) cùng sự bảo trợ bởi Liên đoàn Thương mại và Công nghiệp Việt Nam (VCCI) và kiểm chứng bởi công ty nghiên cứu thị trường Intage Việt Nam đã chính thức công bố kết quả Bảng xếp hạng (BXH) được mong chờ Top 100 Nơi làm việc tốt nhất Việt Nam 2025.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://tphcm.chinhphu.vn/cong-bo-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-101251120085426125.htm\" class=\"btn item-btn btn-success-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">Xem thêm <span class=\"mbrib-right mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 14px;\"></span></a></div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://thanhnien.vn/top-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-doanh-nghiep-nao-dung-dau-185251119145854729.htm\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-321.jpg\" alt title data-slide-to=\"2\" data-bs-slide-to=\"2\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://thanhnien.vn/top-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-doanh-nghiep-nao-dung-dau-185251119145854729.htm\" class=\"text-primary title-link\" target=\"_blank\"><b>Top 100 nơi làm việc tốt nhất Việt Nam năm 2025, doanh nghiệp nào đứng đầu?</b></a></h5>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"https://thanhnien.vn/top-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-doanh-nghiep-nao-dung-dau-185251119145854729.htm\" class=\"text-primary\" target=\"_blank\"><i>https://thanhnien.vn/</i></a></h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">Bảng xếp hạng tôn vinh top 100 nơi làm việc tốt nhất Việt Nam ở khối doanh nghiệp lớn và top 100 nơi làm việc tốt nhất Việt Nam ở khối doanh nghiệp vừa.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://thanhnien.vn/top-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-doanh-nghiep-nao-dung-dau-185251119145854729.htm\" class=\"btn item-btn btn-success-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">Xem thêm <span class=\"mbrib-right mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 14px;\"></span></a></div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://laodong.vn/cong-doan/nhieu-doanh-nghiep-dich-vu-ban-le-lot-top-nha-tuyen-dung-hap-dan-1612904.ldo\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-33.jpg\" alt title data-slide-to=\"3\" data-bs-slide-to=\"3\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://laodong.vn/cong-doan/nhieu-doanh-nghiep-dich-vu-ban-le-lot-top-nha-tuyen-dung-hap-dan-1612904.ldo\" class=\"text-primary title-link\" target=\"_blank\"><b>Nhiều doanh nghiệp dịch vụ, bán lẻ lọt top nhà tuyển dụng hấp dẫn</b></a></h5>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"https://laodong.vn/cong-doan/nhieu-doanh-nghiep-dich-vu-ban-le-lot-top-nha-tuyen-dung-hap-dan-1612904.ldo\" class=\"text-primary\" target=\"_blank\"><i>https://laodong.vn/</i></a></h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">Theo công bố của Công ty Anphabe, nhiều doanh nghiệp dịch vụ, bán lẻ lọt top nhà tuyển dụng hấp dẫn với sinh viên Việt Nam.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://laodong.vn/cong-doan/nhieu-doanh-nghiep-dich-vu-ban-le-lot-top-nha-tuyen-dung-hap-dan-1612904.ldo\" class=\"btn item-btn btn-success-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">Xem thêm <span class=\"mbrib-right mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 14px;\"></span></a></div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://voh.com.vn/radio/doanh-nghiep-va-thuong-hieu-viet/doanh-nghiep-nao-giu-vi-tri-so-1-trong-bang-xep-hang-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-14251126000096609.html?t=60\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-341.jpg\" alt title data-slide-to=\"4\" data-bs-slide-to=\"4\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://voh.com.vn/radio/doanh-nghiep-va-thuong-hieu-viet/doanh-nghiep-nao-giu-vi-tri-so-1-trong-bang-xep-hang-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-14251126000096609.html?t=60\" class=\"text-primary title-link\" target=\"_blank\"><b>Doanh nghiệp nào giữ vị trí số 1 trong bảng xếp hạng 100 nơi làm việc tốt nhất Việt Nam năm 2025?</b></a></h5>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"https://voh.com.vn/radio/doanh-nghiep-va-thuong-hieu-viet/doanh-nghiep-nao-giu-vi-tri-so-1-trong-bang-xep-hang-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-14251126000096609.html?t=60\" class=\"text-primary\" target=\"_blank\"><i>https://voh.com.vn/</i></a></h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">Doanh nghiệp nào giữ vị trí số 1 trong bảng xếp hạng 100 nơi làm việc tốt nhất Việt Nam năm 2025?</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://voh.com.vn/radio/doanh-nghiep-va-thuong-hieu-viet/doanh-nghiep-nao-giu-vi-tri-so-1-trong-bang-xep-hang-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-14251126000096609.html?t=60\" class=\"btn item-btn btn-success-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">Xem thêm <span class=\"mbrib-right mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 14px;\"></span></a></div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://phunuvietnam.vn/100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-20251119195756388.htm\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-342.jpg\" alt title data-slide-to=\"5\" data-bs-slide-to=\"5\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://phunuvietnam.vn/100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-20251119195756388.htm\" class=\"text-primary title-link\" target=\"_blank\"><b>100 nơi làm việc tốt nhất Việt Nam năm 2025</b></a></h5>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"https://phunuvietnam.vn/100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-20251119195756388.htm\" class=\"text-primary\" target=\"_blank\"><i>https://phunuvietnam.vn/</i></a></h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">Bà Thanh Nguyễn, Giám đốc Điều hành và Truyền cảm hứng Hạnh phúc tại Anphabe, Trưởng ban tổ chức Hội nghị, chia sẻ: \"Những phản hồi chân thực từ cộng đồng người đi làm giúp chúng tôi tiếp tục hoàn thiện hệ thống đánh giá, đo lường và tiêu chí\". Theo bà, bảng xếp hạng không chỉ là sự công nhận, mà còn lan tỏa các mô hình tốt về môi trường làm việc hạnh phúc, hướng đến sự phát triển bền vững của cộng đồng doanh nghiệp.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://phunuvietnam.vn/100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-20251119195756388.htm\" class=\"btn item-btn btn-success-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">Xem thêm <span class=\"mbrib-right mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 14px;\"></span></a></div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://vov.vn/doanh-nghiep/100-noi-lam-viec-tot-nhat-viet-nam-nam-2024-post1136683.vov\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-13.jpg\" alt title data-slide-to=\"6\" data-bs-slide-to=\"6\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://vov.vn/doanh-nghiep/100-noi-lam-viec-tot-nhat-viet-nam-nam-2024-post1136683.vov\" class=\"text-primary title-link\" target=\"_blank\"><b>100 Nơi Làm Việc Tốt Nhất Việt Nam năm 2024</b></a></h5>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"https://vov.vn/doanh-nghiep/100-noi-lam-viec-tot-nhat-viet-nam-nam-2024-post1136683.vov\" class=\"text-primary\" target=\"_blank\"><i>vov.vn</i></a></h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">Tối nay (19/11), Công ty cổ phần Anphabe kết hợp Liên đoàn Thương mại và Công nghiệp Việt Nam (VCCI), Công ty nghiên cứu thị trường Intage công bố danh sách những nơi làm...</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\"><a href=\"https://vov.vn/doanh-nghiep/100-noi-lam-viec-tot-nhat-viet-nam-nam-2024-post1136683.vov\" class=\"btn item-btn btn-success-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">Xem thêm <span class=\"mbrib-right mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 14px;\"></span></a></div>\n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://baotintuc.vn/doanh-nghiep-doanh-nhan/cong-bo-100-noi-lam-viec-tot-nhat-viet-nam-nam-2024-20241119204545387.htm\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-4.jpg\" alt title data-slide-to=\"7\" data-bs-slide-to=\"7\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://baotintuc.vn/doanh-nghiep-doanh-nhan/cong-bo-100-noi-lam-viec-tot-nhat-viet-nam-nam-2024-20241119204545387.htm\" class=\"text-primary title-link\" target=\"_blank\"><b>Công bố 100 nơi làm việc tốt nhất Việt Nam năm 2024</b></a></h