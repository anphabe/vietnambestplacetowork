erlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/mb-top100-2.jpg\" alt=\"MBers tham gia thử thách chạy bộ, HiGreen – Bình Minh Xanh do MBBank khởi xướng nhằm truyền tải thông điệp sống bền vững, quan tâm tới môi trường và cộng đồng\">\n                    <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-description\"><i>MBers tham gia thử thách chạy bộ, HiGreen – Bình Minh Xanh do MBBank khởi xướng nhằm truyền tải thông điệp sống bền vững, quan tâm tới môi trường và cộng đồng</i><br></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
