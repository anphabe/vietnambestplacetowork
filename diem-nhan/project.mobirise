              "text-align": "left"
            }
          },
          "_name": "content5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\">Không chỉ riêng anh Hải, chị Lê Hoàng Sao Duyên, hiện là Quản lý cửa hàng McDonald's AEON Mall Bình Dương, cũng từng trải qua những cảm xúc lo lắng tương tự khi quay trở lại làm việc. Tuy nhiên, nhờ có sự hỗ trợ và chỉ dẫn tận tình từ đồng nghiệp cũ, chị đã nhanh chóng vượt qua những nỗi lo ban đầu và nhanh chóng hòa nhập. \"Vào ngày đầu tiên đi làm, mọi cảm xúc lo lắng đó đã biến mất nhờ vào sự sắp xếp của công ty khi cho em làm việc tại cửa hàng lúc xưa. Cả anh chị quản lý và các bạn nhân viên cũ đều vẫn còn làm ở đây; mọi người đã chào đón cũng như giúp đỡ em rất nhiều trong những ngày đầu làm quen lại với mọi thứ.\"&nbsp;</h3>                \n                <p class=\"mbr-text mbr-fonts-style mb-3\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Sự chào đón nồng nhiệt không chỉ dừng lại ở tấm lòng mà còn bằng những hành động cụ thể, như tổ chức các buổi gặp mặt, trò chuyện, các hoạt động giao lưu tạo điều kiện cho nhân viên mới và cũ thêm gắn kết. Chính những nỗ lực này đã giúp McDonald’s Việt Nam tạo nên một môi trường làm việc đoàn kết, gắn bó như một tập thể. <br></p>\n          </div>\n        </div>\n    </div>\n</section>",
