                  "margin-top": "2px",
                  "padding-bottom": ".5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-unity": {
                  "display": "none"
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
