          },
          "_name": "content5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n                    <b>Article Title</b>\n                </h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\"><b>Ngày 19/11, công ty LEGO Manufaturing Việt Nam được vinh danh Top 2 “Nơi Làm Việc Tốt Nhất Việt Nam® 2024 – Khối Doanh Nghiệp Vừa” (Vietnam Best Places To Work® 2024).</b></h4>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "uxKmC0Ty8S",
          "_anchor": "content5-j7",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".mbr-text": {
              "text-align": "left"
            }
          },
          "_name": "content5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"></h3>                \n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Lần đầu tiên góp mặt trong bảng xếp hạng 100 Nơi Làm Việc Tốt Nhất Việt Nam® - Khối Doanh Nghiệp Vừa, LEGO đã xuất sắc đạt vị trí Top 1 ngành Sản xuất, Công nghiệp chế biến/chế tạo và Top 2 Nơi Làm Việc Tốt Nhất Việt Nam - Khối Doanh Nghiệp Vừa 2024. Đây là kết quả từ bảng xếp hạng uy tín được thực hiện từ khảo sát độc lập của Anphabe – đơn vị tư vấn hàng đầu về Thương hiệu Nhà tuyển dụng và Môi trường làm việc Hạnh phúc – với sự bảo trợ của Liên đoàn Thương mại và Công nghiệp Việt Nam (VCCI). Thành tựu này khẳng định nỗ lực của LEGO trong việc xây dựng một môi trường làm việc sáng tạo, hòa nhập và đầy cảm hứng, nơi mỗi nhân viên đều được phát huy tối đa tiềm năng để cùng cống hiến cho sự phát triển bền vững của tập đoàn.<br><br><b>Tích cực tuyển dụng và đào tạo trong lĩnh vực công nghệ và đổi mới sáng tạo\n</b><br>\n<br>Tập đoàn LEGO cam kết phát triển nguồn nhân lực địa phương chất lượng cao với mục tiêu tạo ra hơn 4.000 việc làm trong lĩnh vực công nghệ và đổi mới sáng tạo trong thời gian tới. Để đạt được điều này, Tập đoàn đã tổ chức nhiều chương trình đào tạo và trao quyền cho nhân viên tại Việt Nam, giúp họ có thể vận hành các thiết bị sản xuất công nghệ cao một cách chính xác.<br></p>\n</div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "uxKmC1baLl",
