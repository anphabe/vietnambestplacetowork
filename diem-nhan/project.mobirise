    "bidv-khang-dinh-vi-the-doanh-nghiep-vnbptw-2024.html": {
      "settings": {
        "title": "BIDV khẳng định vị thế doanh nghiệp có môi trường làm việc tốt nhất Việt Nam",
        "order": "7",
        "header_custom": "",
        "socialSharingUrl": "",
        "footer_custom": "",
        "meta_descr": "Ngày 19.11.2024, Ngân hàng TMCP Đầu tư và Phát triển Việt Nam (BIDV) đã được vinh danh \"Nơi làm việc tốt nhất Việt Nam 2024\" với vị trí top đầu trong bảng xếp hạng. Giải thưởng đã khẳng định vị thế của định chế tài chính lớn nhất, một doanh nghiệp có môi trường làm việc hàng đầu tại Việt Nam.",
        "meta_image": "@PROJECT_PATH@/assets/images/bidv-pr1.jpg"
      },
