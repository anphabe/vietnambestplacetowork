    "schaeffler-lan-thu-hai-duoc-vinh-danh-vnbptw-2024.html": {
      "settings": {
        "title": "Schaeffler lần thứ hai được vinh danh là Nơi làm việc tố nhất Việt Nam",
        "order": "14",
        "header_custom": "",
        "socialSharingUrl": "",
        "footer_custom": "",
        "meta_descr": "Trong khuôn khổ Hội nghị Nơi làm việc tốt nhất Việt Nam 2024, Schaeffler được vinh danh trong bảng xếp hạng “Nơi làm việc tốt nhất Việt Nam” năm 2024, theo đánh giá của Công ty Anphabe và Công ty nghiên cứu thị trường Intage. Đây là năm thứ hai liên tiếp Schaeffler nhận được danh hiệu này, ghi dấu những nỗ lực không ngừng của tập đoàn nhằm tạo ra môi trường làm việc lý tưởng và phù hợp với người lao động tại Việt Nam.",
        "meta_image": "@PROJECT_PATH@/assets/images/schaeffler-pr1.jpg"
      },
      "components": [
