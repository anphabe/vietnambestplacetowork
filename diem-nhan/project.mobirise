        "socialSharingUrl": "",
        "footer_custom": "",
        "meta_descr": "Vào ngày 19/11/2024, Tập Đoàn VAS được vinh danh là Nơi Làm Việc Tốt Nhất Việt Nam® 2024, đánh dấu bước tiến quan trọng trong cam kết tạo dựng môi trường làm việc tích cực cho nhân viên và đóng góp giá trị cho cộng đồng.",
        "meta_image": "@PROJECT_PATH@/assets/images/vas-pr1.jpg"
      },
      "components": [
