    "van-phu-invest-lot-top-100-noi-lam-viec-tot-nhat-viet-nam.html": {
      "settings": {
        "title": "Văn Phú Invest lọt Top 100 nơi làm việc tốt nhất Việt Nam",
        "order": "17",
        "header_custom": "",
        "socialSharingUrl": "",
        "footer_custom": "",
        "meta_descr": "Văn Phú - Invest vừa được vinh danh Top 100 Nơi làm việc Tốt nhất Việt Nam năm 2024 - Khối Doanh nghiệp vừa. Nơi làm việc tốt nhất Việt Nam là bảng xếp hạng môi trường làm việc do Anphabe - đơn vị tư vấn hàng đầu về giải pháp thương hiệu nhà tuyển dụng và môi trường làm việc hạnh phúc - tổ chức thường niên, với sự bảo trợ của Liên đoàn Thương mại và Công nghiệp Việt Nam (VCCI). Mô hình và phương pháp đánh giá được kiểm chứng bởi công ty nghiên cứu thị trường Intage Việt Nam.",
        "meta_image": "@PROJECT_PATH@/assets/images/vanphu-invest-pr1.jpg"
      },
