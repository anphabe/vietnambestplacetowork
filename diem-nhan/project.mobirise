    "sabeco-hanh-trinh-ghi-dau-thanh-tich-vang-vnbptw-2024.html": {
      "settings": {
        "title": "SABECO: Hành trình ghi dấu thành tích vàng với cam kết vì người lao động và cộng đồng",
        "order": "12",
        "header_custom": "",
        "socialSharingUrl": "",
        "footer_custom": "",
        "meta_descr": "Tiếp tục khẳng định vị thế là một trong những doanh nghiệp hàng đầu tại Việt Nam, SABECO vinh dự được xướng tên trong danh sách Top 100 Nơi Làm Việc Tốt Nhất Việt Nam® 2024 – Khối Doanh Nghiệp Lớn của Anphabe. SABECO không chỉ mang lại môi trường làm việc lý tưởng mà còn đóng góp tích cực cho cộng đồng và nền kinh tế Việt Nam.",
        "meta_image": "@PROJECT_PATH@/assets/images/sabeco-pr1.jpg"
      },
      "components": [
