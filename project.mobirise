              "padding-left": "1rem",
              "padding-right": "1rem",
              "background-color": "#093d5a",
              "min-height": "10vh"
            },
            ".plan-title": {
              "color": "#ffffff"
            },
            ".plan .list-group-item": {
              "position": "relative",
              "justify-content": "center",
              "border": "0",
              "padding": "1.5rem 1rem"
            },
            ".plan .list-group-item::after": {
              "position": "absolute",
              "bottom": "1px",
              "left": "25%",
              "width": "50%",
              "height": "1px",
              "content": "\"\"",
              "background-color": "rgba(0, 0, 0, 0.1)"
            },
            ".display-7": {
              "font-family": "'Mulish', sans-serif",
              "font-size": "1.1rem",
              "line-height": "1.5"
            },
            "#btn-back-to-top": {
              "position": "fixed",
              "bottom": "20px",
              "right": "20px",
              "display": "none",
              "z-index": "1000"
            }
          },
          "_name": "content17",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content17\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-switch-arrow, mobirise-icons2\">\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"9\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <select title=\"Amount\" name=\"cardAmount\">\n             <option value=\"1\">1</option>\n             <option value=\"2\">2</option>\n             <option value=\"3\">3</option>\n             <option value=\"4\">4</option>\n             <option value=\"5\">5</option>\n             <option value=\"6\">6</option>\n             <option value=\"7\">7</option>\n             <option value=\"8\">8</option>\n             <option value=\"9\" selected>9</option>\n\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    \n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        \n            <div class=\"row justify-content-center\">\n                <div class=\"col-12 col-md-{{textWidth}}\">\n                    <div class=\"section-head align-center mb-4\" mbr-if=\"showTitle || showSubtitle\">\n                        <h3 class=\"mbr-section-title mb-0 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            <b>Câu hỏi thường gặp</b></h3>\n                        <h4 class=\"mbr-section-subtitle mt-2 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            Subtitle</h4>\n                    </div>\n                    \n                    <div id=\"bootstrap-toggle\" class=\"toggle-panel accordionStyles tab-content\">\n                        <div class=\"card mb-3\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>1. Khảo sát Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> là gì?</b></h6>\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Khởi xướng từ năm 2013, Khảo sát Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> là chương trình khảo sát chuyên sâu và uy tín hàng đầu về Thương hiệu Nhà tuyển dụng (THNTD, do <b>Anphabe</b> tổ chức hàng năm, dưới sự bảo trợ của <b>Liên đoàn Thương mại và Công nghiệp Việt Nam (VCCI)</b>. Mô hình và phương pháp đánh giá được kiểm chứng bởi đơn vị thứ ba là công ty nghiên cứu thị trường <b>Intage Việt Nam</b> để đảm bảo tính công bằng và khách quan. </p>\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Khảo sát Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> được thực hiện hoàn toàn độc lập, trung bình mỗi năm ghi nhận ý kiến đánh giá khách quan của hàng chục ngàn người lao động trên toàn quốc, và đo lường sức hấp dẫn Thương hiệu Nhà tuyển dụng của gần <b>800 </b>doanh nghiệp hàng đầu thuộc <b>18</b> nhóm ngành nghề khác nhau tại Việt Nam. Chương trình đến nay đã thu hút được hàng triệu lượt quan tâm, chia sẻ và gợi nhắc từ các đơn vị truyền thông báo chí,truyền hình hàng đầu cả nước. </p>\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Khảo sát mỗi năm đều đưa ra được những phân tích giá trị về xu hướng người đi làm và môi trường làm việc mới nhất, đến nay luôn được xem là nguồn thông tin giá trị và chuyên nghiệp cho các CEO và lãnh đạo nhân sự trong việc định hướng chiến lược nhân tài.&nbsp;</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 1\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>2. Vì sao Doanh nghiệp nên tham gia khảo sát Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup>?</b></h6>\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down\"></span>\n                                </a>\n\n                            </div>\n                            <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Khi tham gia Khảo sát, doanh nghiệp sẽ được: </p>\n                                    <ul class=\"mbr-fonts-style panel-text display-7\">\n                                      <li><b>Cải thiện nội lực tổ chức:</b> Giá trị cốt lõi của Khảo sát Nơi Làm Việc Tốt Nhất Việt Nam® là khả năng đo lường và đánh giá một cách khoa học Sức hấp dẫn thương hiệu nhà tuyển dụng, thông qua lăng kính khách quan của người lao động. Doanh nghiệp tham gia Khảo sát sẽ có cơ hội nhận được Báo cáo phân tích chuyên sâu về hình ảnh Thương hiệu nhà tuyển dụng của công ty mình với các điểm mạnh, điểm yếu cụ thể, so sánh với các đối thủ cạnh tranh để có được cái nhìn toàn cảnh về vị thế của công ty trên thị trường. Báo cáo cũng kèm theo các khuyến nghị và đề xuất cải thiện hiệu quả từ Anphabe. </li>\n                                      <li><b>Cơ hội được vinh danh Nơi Làm Việc Tốt Nhất Việt Nam®</b>: Doanh nghiệp tham gia Khảo sát, nếu được người đi làm đánh giá cao, sẽ có cơ hội được vinh danh tại Hội nghị Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> (quy tụ gần 800 lãnh đạo doanh nghiệp và nhiều đơn vị truyền thông hàng đầu cả nước). Nhờ đó, hình ảnh Thương hiệu nhà tuyển dụng của doanh nghiệp sẽ được quảng bá rộng rãi đến đông đảo người đi làm và lan tỏa niềm tự hào với nhân viên nội bộ. </li>\n                                      <li><b>Cập nhật các xu hướng Nhân sự quan trọng:</b> Tổng hợp từ phản hồi của hàng chục ngàn người lao động, Khảo sát mỗi năm cập nhật những xu hướng mới nhất về thị trường nhân tài và môi trường làm việc, giải mã những thay đổi trong mong đợi và kỳ vọng của người lao động, giúp doanh nghiệp kịp thời điều chỉnh chiến lược, chủ động ứng phó và thích nghi với xu hướng của thị trường. Ngoài ra, doanh nghiệp tham dự Hội nghị Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> còn được giao lưu, học hỏi với những chuyên gia hàng đầu trong lĩnh vực quản trị nhân sự, và mở rộng quan hệ kết nối với nhiều lãnh đạo doanh nghiệp khác.</li>\n                                    </ul>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 2\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>3. Đối tượng tham gia khảo sát Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup>?</b></h6>\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Chương trình <b>Khảo sát</b> <b>Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup></b> được thực hiện hoàn toàn độc lập, ghi nhận những ý kiến đánh giá khách quan từ người đi làm có kinh nghiệm, thuộc <b>18&nbsp;nhóm ngành nghề</b> khác nhau tại Việt Nam.</p>\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Bên cạnh đó, từ 2020, khảo sát cũng mở rộng đối tượng tham gia đến nhóm sinh viên tại các trường Đại học/Cao đẳng trên cả nước, đây là nguồn nhân lực tương lai quan trọng mà doanh nghiệp nào cũng quan tâm.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 3\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>4. Doanh nghiệp tham gia khảo sát thì có chắc chắn vào Bảng xếp hạng Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> không?</b></h6>\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Việc một công ty có tên trong <b>Bảng xếp hạng Nơi Làm Việc Tốt Nhất Việt Nam®</b> hay không phụ thuộc hoàn toàn vào kết quả đo lường và bình chọn từ người lao động. Khảo sát này được Anphabe thực hiện với vai trò độc lập, ghi nhận những ý kiến đánh giá hoàn toàn khách quan của người đi làm.</p>\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Dựa trên những đánh giá đó, Anphabe mới tiến hành đo lường và tính điểm chỉ số Sức hấp dẫn Thương hiệu Nhà tuyển dụng của từng doanh nghiệp. Về kết quả, chỉ 100 công ty thuộc Khối Doanh Nghiệp Lớn và 100 công ty thuộc Khối Doanh Nghiệp Vừa có số điểm cao nhất từ trên xuống dưới mới có cơ hội được ghi tên mình lên Bảng xếp hạng.</p>\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Mô hình và phương pháp đo lường của Khảo sát cũng đồng thời được kiểm chứng bởi đơn vị thứ ba là công ty nghiên cứu thị trường Intage Việt Nam, đảm bảo kết quả luôn khách quan và công bằng.Do đó, không phải tất cả công ty tham gia Khảo sát đều sẽ được vinh danh trong Bảng xếp hạng.&nbsp;</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 4\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                   <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>5. Doanh nghiệp như thế nào thì đủ điều kiện tham gia khảo sát Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup>?</b></h6>\n                                        <span class=\"mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Các điều kiện cơ bản đầu tiên:</p>\n                                    <ul class=\"mbr-fonts-style panel-text display-7\">\n                                      <li>Công ty có ít nhất 3 năm hoạt động tại Việt Nam.</li>\n                                      <li>Có quy mô ít nhất 100 người (trừ 1 số công ty nước ngoài ngành dịch vụ có Văn phòng đại diện ở Việt Nam).</li>\n                                      <li>Hiện tại không có các vấn đề về pháp lý.</li>\n                                    </ul>                                   \n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Bắt đầu từ năm 2023, nhằm tạo sân chơi toàn diện hơn cho các Doanh Nghiệp, bảng xếp hạng Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> được chia làm 2 sân chơi, Anphabe sẽ liên hệ và tư vấn cụ thể với từng đối tượng doanh nghiệp. Cụ thể:</p>\n                                    <ul class=\"mbr-fonts-style panel-text display-7\">\n                                      <li>BXH 100 Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> – Khối Doanh Nghiệp Lớn</li>\n                                      <li>BXH 100 Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> – Khối Doanh Nghiệp Vừa</li>\n                                    </ul>                                \n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 5\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>6. Các lựa chọn đăng ký và chi phí tham gia khảo sát Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup>?</b></h6>\n                                    <span class=\"mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                       Tùy vào nhu cầu, doanh nghiệp có thể lựa chọn các gói đăng ký tham gia khảo sát Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> thuộc các đề xuất sau:</p>\n                                    <div class=\"row justify-content-center\">\n                                        <div class=\"col-12 col-md-6 align-center col-lg-3\">\n                                            <div class=\"plan\">\n                                                <div class=\"plan-header\">\n                                                    <h6 class=\"plan-title mbr-fonts-style mb-3 display-7\">\n                                                        <strong>THAM GIA</strong><br><strong>KHẢO SÁT</strong></h6>\n                                                </div>\n                                                <div class=\"plan-body\">\n                                                    <div class=\"plan-list mb-4\">\n                                                        <ul class=\"list-group mbr-fonts-style list-group-flush display-7\">\n                                                            <li class=\"list-group-item\">Đẩy mạnh sức hấp dẫn Thương hiệu nhà tuyển dụng (THNTD)</li>\n                                                            <li class=\"list-group-item\">Được cập nhật xu hướng mới nhất trên thị trường thông qua hội nghị</li>\n                                                            <li class=\"list-group-item\">Cơ hội vinh danh trong Top 100 Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> toàn thị trường và theo ngành</li>\n                                                        </ul>\n                                                    </div>\n                                                    \n                                                </div>\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-6 align-center col-lg-3\">\n                                            <div class=\"plan\">\n                                                <div class=\"plan-header\">\n                                                    <h6 class=\"plan-title mbr-fonts-style mb-3 display-7\">\n                                                        <strong>BÁO CÁO</strong><br><strong>XU HƯỚNG</strong></h6>\n                                                </div>\n                                                <div class=\"plan-body\">\n                                                    <div class=\"plan-list mb-4\">\n                                                        <ul class=\"list-group mbr-fonts-style list-group-flush display-7\">\n                                                            <li class=\"list-group-item\">Xu hướng nhân tài, Nguồn nhân lực &amp; Môi trường làm việc</li>\n                                                            <li class=\"list-group-item\">Động cơ nghề nghiệp của người đi làm trong ngành</li>\n                                                            <li class=\"list-group-item\">Mục tiêu nghề nghiệp của người đi làm trong ngành và toàn thị trường</li>\n                                                        </ul>\n                                                    </div>\n                                                    \n                                                </div>\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-6 align-center col-lg-3\">\n                                            <div class=\"plan\">\n                                                <div class=\"plan-header\">\n                                                    <h6 class=\"plan-title mbr-fonts-style mb-3 display-7\">\n                                                        <strong>BÁO CÁO SỨC KHỎE THNTD</strong></h6>\n                                                </div>\n                                                <div class=\"plan-body\">\n                                                    <div class=\"plan-list mb-4\">\n                                                        <ul class=\"list-group mbr-fonts-style list-group-flush display-7\">\n                                                            <li class=\"list-group-item\">Sức hấp dẫn THNTD, điểm mạnh - yếu của công ty</li>\n                                                            <li class=\"list-group-item\">So sánh với 3-4 công ty đối thủ (nếu có)</li>\n                                                            <li class=\"list-group-item\">Tư vấn cải tiến sức khỏe THNTD</li>\n                                                        </ul>\n                                                    </div>\n                                                    \n                                                </div>\n                                            </div>\n                                        </div>\n                                        <!--<div class=\"col-12 col-md-6 align-center col-lg-3\">\n                                            <div class=\"plan\">\n                                                <div class=\"plan-header\">\n                                                    <h6 class=\"plan-title mbr-fonts-style mb-3 display-7\">\n                                                        <strong>BÁO CÁO KHẢO SÁT NỘI BỘ</strong></h6>\n                                                </div>\n                                                <div class=\"plan-body\">\n                                                    <div class=\"plan-list mb-4\">\n                                                        <ul class=\"list-group mbr-fonts-style list-group-flush display-7\">\n                                                            <li class=\"list-group-item\">Bức tranh Nguồn nhân lực hạnh phúc theo nhóm nhân viên</li>\n                                                            <li class=\"list-group-item\">Đánh giá toàn diện 15-24 nhóm điều kiện Hạnh Phúc</li>\n                                                            <li class=\"list-group-item\">Tư vấn cơ hội tối đa hóa hiệu suất và lòng trung thành của nhân viên</li>\n                                                        </ul>\n                                                    </div>\n                                                    \n                                                </div>\n                                            </div>\n                                        </div>-->\n                                    </div>\n                                    <br>\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"> Để được tư vấn gói tham gia với chi phí phù hợp, quý doanh nghiệp vui lòng điền thông tin <b><u><a href=\"lien-he.html\" class=\"text-primary\" target=\"_blank\">tại đây</a></u></b> hoặc liên hệ với Anphabe để được giải đáp trực tiếp:</p>\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    Hotline: <b>(+84) 28 6268 2222</b><br>\n                                    E-mail: <a href=\"mailto:clientsolution@anphabe.com\" class=\"text-primary\"><b>clientsolution@anphabe.com</b></a><br>\n                                    Website: <a href=\"https://vietnambestplacestowork.com/\" class=\"text-primary\" target=\"_blank\"><b>https://vietnambestplacestowork.com/</b></a></p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 6\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse7\" aria-expanded=\"false\" aria-controls=\"collapse7\">\n                                   <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>7. Khảo sát Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup> được thực hiện trong thời gian nào?</b></h6>\n                                        <span class=\"mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse7\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>Khảo sát Nơi Làm Việc Tốt Nhất Việt Nam®</b> được Anphabe thực hiện thường niên, thời gian cụ thể sẽ được công bố trên các trang truyền thông chính thức của chương trình.</p>\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>Khảo sát Nơi Làm Việc Tốt Nhất Việt Nam® 2026</b> (năm thứ 13) đã chính thức được khởi động và bắt đầu tiếp nhận hồ sơ đăng ký từ doanh nghiệp đến hết ngày <b>31/03/2026</b>. Khảo sát dự kiến sẽ được khởi chạy từ <b>Tháng 4 - Tháng 7/2026</b>. Những phân tích và kết quả sau Khảo sát sẽ được công bố vào <b>Tháng 11/2026</b> tại <b>Hội Nghị Nơi Làm Việc Tốt Nhất Việt Nam® 2026</b>. Quý doanh nghiệp quan tâm và mong muốn tham gia, vui lòng liên hệ với Anphabe để được tư vấn trực tiếp hoặc đăng ký tại website:</p>\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                        Hotline: <b>(+84) 28 6268 2222</b><br>\n                                        E-mail: <a href=\"mailto:clientsolution@anphabe.com\"><b>clientsolution@anphabe.com</b></a><br>\n                                        Website: <a href=\"https://vietnambestplacestowork.com/\" class=\"text-primary\"><b>https://vietnambestplacestowork.com/</b></a>\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-3\" mbr-if=\"cardAmount > 7\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse8\" aria-expanded=\"false\" aria-controls=\"collapse8\">\n                                   <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\"><b>8. Sau khi kết thúc khảo sát, khi nào doanh nghiệp sẽ nhận được nhận báo cáo?</b></h6>\n                                        <span class=\"mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse8\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Dự kiến Báo cáo sẽ được gửi đến quý doanh nghiệp sau khi kết thúc Hội nghị và theo thứ tự đăng ký với BTC</p>\n                                </div>\n                            </div>\n                        </div>\n                        \n                    </div>\n                </div>\n            </div>\n        </div>\n</section>",
