              }
            },
            ".plan": {
              "word-break": "break-word",
              "background-color": "#ffffff",
              "box-shadow": "0px 6px 10px -5px rgba(0, 0, 0, 0.3)",
              "height": "100%"
            },
            ".plan-header": {
              "padding-top": "1rem",
