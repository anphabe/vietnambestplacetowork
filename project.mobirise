          "_name": "gallery3",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery3 witsec-draft-mode\" group=\"Sliders &amp; Galleries\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <select title=\"Columns\" name=\"cardsWidth\">\n            <option value=\"12\">1</option>\n            <option value=\"6\">2</option>\n            <option value=\"4\">3</option>\n            <option value=\"3\" selected=\"\">4</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\">\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"autoSize &amp;&amp; !(showButtons==false &amp;&amp; showCardSubtitle==false &amp;&amp; showCardTitle==false &amp;&amp; showText==false)\">\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Subtitle\">\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <input type=\"checkbox\" name=\"transparent\" title=\"Transparent BG\">\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#fafafa\" condition=\"(transparent==false)\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>Full-Width Gallery</b>\n            </h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Images with Title and Text</h5>\n        </div>\n        <div class=\"row mt-4\">\n         <div id=\"bptw-gallery\">\n            <a href=\"@PROJECT_PATH@/assets/images/pic1.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic1.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic3.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic3.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic15.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic15.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic11.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic11.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic12.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic12.jpg\" alt=\"\">\n            </a>\n            \n            <a href=\"@PROJECT_PATH@/assets/images/pic5.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic5.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic6.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic6.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic7.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic7.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic8.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic8.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic9.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic9.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic10.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic10.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic13.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic13.jpg\" alt=\"\">\n            </a>\n            <a href=\"@PROJECT_PATH@/assets/images/pic14.jpg\">\n              <img src=\"@PROJECT_PATH@/assets/images/pic14.jpg\" alt=\"\">\n            </a>\n            \n          </div>\n            \n        </div>\n    </div>\n<style class=\"witsec-draft-mode-style\">.witsec-draft-mode { border: 3px dashed red; }</style></section>",
