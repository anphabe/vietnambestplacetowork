        {
          "alias": "witsec-code-editor/components",
          "_isSecondary": true,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".form-control": {
              "line-height": "1.2rem !important"
            },
            ".bptw, .form-select": {
              "font-family": "'Mulish', sans-serif"
            },
            ".ranking-item:nth-child(even) .card": {
              "background-color": "#ededed !important"
            }
          },
          "_name": "witsec-html-block",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section class=\"mbr-section mbr-section--no-padding\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <!-- Place your own code below -->\n    <div class=\"container bptw\">\n        <div class=\"row justify-content-between pb-2 pb-md-4\">\n            <div class=\"col-12 col-md-8\">\n                <input type=\"hidden\" value=\"top100sme\" id=\"award\">\n                \n                <h3 class=\"h5\" data-app-selector=\".card-box .mbr-text, .mbr-section-btn\">Hạng mục giải thưởng:</h3>\n                <ul data-app-selector=\".card-box .mbr-text, .mbr-section-btn fs-3\">\n                  <li><p class=\"mb-1\"><a href=\"top-100-noi-lam-viec-tot-nhat-viet-nam-2023.html\" class=\"text-success\" style>Top 100 Nơi làm việc tốt nhất Việt Nam khối Doanh Nghiệp Lớn</a></p></li>\n                  <li><p class=\"mb-1\"><a href=\"top-100-noi-lam-viec-tot-nhat-viet-nam-2023-doanh-nghiep-vua.html\" class=\"text-success text-primary\" style><b>Top 100 Nơi làm việc tốt nhất Việt Nam khối Doanh Nghiệp Vừa</b></a></p></li>\n                  <li><p class=\"mb-1\"><a href=\"top-50-thuong-hieu-nha-tuyen-dung-hap-dan-voi-sinh-vien-viet-nam-2023.html\" class=\"text-success text-primary\">Top 50 Thương hiệu nhà tuyển dụng hấp dẫn với sinh viên Việt Nam 2023</a></p></li>\n                  <li><p class=\"mb-1\"><a href=\"top15-haw-2023.html\" class=\"text-success text-primary\">Top 15 Doanh nghiệp tiêu biểu có nguồn nhân lực Hạnh phúc 2023 - Khối Doanh Nghiệp Lớn</a></p></li>\n                  <li><p class=\"mb-1\"><a href=\"top15-haw-2023-sme.html\" class=\"text-success text-primary\">Top 15 Doanh nghiệp tiêu biểu có nguồn nhân lực Hạnh phúc 2023 - Khối Doanh Nghiệp Vừa</a></p></li>\n                </ul>    \n\n\n            </div>\n            <div class=\"col-12 col-md-4\">\n                <div class=\"row justify-content-end align-items-center\">\n                  <label for=\"select_year\" class=\"col-2 col-form-label text-end p-0\">Năm</label>\n                  <div class=\"col-5\">\n                    <select id=\"select_year\" name=\"select_year\" class=\"form-select mbr-text display-7\">\n                    <option value=\"2025\">2025</option>\n                        <option value=\"2024\">2024</option>\n                        <option value=\"2023\" selected>2023</option>\n                        <option value=\"2022\">2022</option>\n                        <option value=\"2021\">2021</option>\n                        <option value=\"2020\">2020</option>\n                        <option value=\"2018\">2018</option>\n                        <option value=\"2017\">2017</option>\n                        <option value=\"2016\">2016</option>\n                        <option value=\"2015\">2015</option>\n                        <option value=\"2014\">2014</option>\n                        <option value=\"2013\">2013</option>\n                      </select>\n                  </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row justify-content-between\">\n            <div class=\"col-12 col-md-5\">\n                <div class=\"bptw__filter\">\n\n                    <select id=\"select_industry\" name=\"select_industry\" class=\"form-select form-select-lg mb-3 mbr-text\" aria-label=\".form-select-lg\">\n                      <option value=\"\" selected=\"\">Xếp hạng theo ngành</option>\n                      <option value=\"10014000sme\">Du lịch/ Ẩm thực/ Nghỉ dưỡng</option>\n                      <option value=\"10028000sme\">Dịch vụ (Đào tạo, Tư vấn, Truyền thông, Giải trí...)</option>\n                      <option value=\"10026000sme\">Bán lẻ/ Bán sỉ/ Thương mại\t</option>\n                      <option value=\"10016000sme\">Bảo hiểm</option>\n                      <option value=\"10025100sme\">Bất động sản/ Dịch vụ bất động sản\t</option>\n                      <option value=\"10020100sme\">Công nghệ thông tin/ Phần mềm &amp; Ứng dụng/ Thương mại điện tử</option>\n                      <option value=\"10005200sme\">Dịch vụ tài chính</option>\n                      <option value=\"10008000sme\">Điện tử/ Công nghệ cao/ Thiết bị Phụ trợ</option>\n                      <option value=\"10024000sme\">Dược/ Thiết bị y tế/ Chăm sóc sức khỏe</option>\n                      <option value=\"10011000sme\">Hàng tiêu dùng</option>\n                      <option value=\"10009000sme\">Kỹ thuật/ Máy móc/ Cơ khí Công nghiệp</option>\n                      <option value=\"10005100sme\">Ngân hàng</option>\n                      <option value=\"10002000sme\">Nông nghiệp/ Lâm nghiệp/ Thủy sản</option>\n                      <option value=\"10015100sme\">Sản xuất/ Công nghiệp chế biến, chế tạo</option>\n                      <option value=\"10027000sme\">Hậu cần/ Vận tải</option>\n                      <option value=\"10006300sme\">Vật liệu (Công nghiệp, Xây dựng…)</option>\n                      <option value=\"10019000sme\">Viễn thông/ Hạ tầng/ Công nghệ phần cứng</option>\n                      <option value=\"10006200sme\">Xây dựng/ Kiến trúc</option>\n                    </select>\n               \n                    \n                </div>\n            </div>\n            <div class=\"col-12 col-md-2\">\n              <div class=\"text-md-end\">\n                      <span id=\"bptw-view-grid\" title=\"View grid\" mbr-icon class=\"p-2 mbr-iconfont mbrib-extension\" style=\"font-size: 25px; color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                      <span id=\"bptw-view-table\" title=\"View list\" mbr-icon class=\"p-2 mbr-iconfont mbrib-bulleted-list\" style=\"font-size: 25px; color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n              </div>\n            </div>\n        </div>\n    </div>\n    <!-- Place your own code above -->\n\n\n</section>",
