        "meta_descr": "Liên hệ đăng ký tham gia Khảo sát Nơi làm việc tốt nhất Việt nam.",
        "header_custom": "",
        "footer_custom": "<script src=\"https://www.anphabe.com/sites/all/modules/mio/sales_lead/js/sales_lead.js\"></script>",
        "html_before": "",
        "order": "5",
        "socialSharingUrl": "https://vietnambestplacestowork.com/assets/images/vietnamese-attractive-employers-2022-700.jpg"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
