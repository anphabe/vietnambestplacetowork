    "cau-hoi-thuong-gap.html": {
      "settings": {
        "title": "Câu hỏi thường gặp",
        "order": "3",
        "meta_descr": "Khảo sát nơi làm việc tốt nhất Việt Nam là gì? Từ năm 2013, Anphabe tự hào khởi xướng Khảo sát Nơi làm việc tốt nhất Việt Nam®, đây là khảo sát uy tín hàng đầu về Thương hiệu Nhà tuyển dụng (THNTD) thu hút hàng triệu lượt quan tâm, chia sẻ và gợi nhắc từ giới truyền thông báo chí và truyền hình, được tổ chức hàng năm bởi Anphabe.",
        "socialSharingUrl": ""
      },
