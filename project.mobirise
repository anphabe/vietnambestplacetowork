          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "gallery6-dm",
          "_isUserblock": true,
          "_cid": "uwwrSr9TzD",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background": "linear-gradient(@bg-value 50%, #f5f5f5 50%)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "img, .item-img": {
              "& when (@autoSize)": {
                "height": "100%",
                "object-fit": "cover",
                "& when (@showCardTitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showCardSubtitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showText)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showButtons)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "cursor": "pointer",
              "margin-bottom": "2rem"
            },
            "& when not (@spacing)": {
              ".row": {
                "margin-left": "0",
                "margin-right": "0"
              },
              ".item": {
                "padding": "0",
                "margin": "0"
              }
            },
            ".item-wrapper": {
              "position": "relative",
              "border-radius": "4px",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap",
              ".item-footer": {
                "height": "60px"
              },
              "@media (min-width: 992px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem 2rem 0"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem"
                  }
                }
              },
              "@media (max-width: 991px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem 1rem 0"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem"
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left"
            },
            ".item-title": {
              "text-align": "left",
              "color": "#232323"
            },
            ".item-subtitle": {
              "text-align": "left",
              "color": "#232323"
            },
            ".view-more": {
              ".btn": {
                "font-size": "20px",
                "color": "#000 !important",
                "&:hover": {
                  "color": "#000 !important"
                }
              },
              ".btn .mbr-iconfont-btn": {
                "display": "inline-block",
                "width": "22px",
                "height": "22px",
                "color": "#ffa800",
                "font-size": "15px !important",
                "font-weight": "700",
                "padding": "4px 0px 0px 2px",
                "background": "black",
                "border-radius": "3px"
              }
            },
            ".mbr-iconfont-btn": {
              "font-weight": "700"
            },
            ".item-footer .btn": {
              "position": "absolute",
              "bottom": "0",
              "right": "0",
              "margin": "0",
              "width": "52px",
              "padding-left": "15px"
            },
            ".txcolor": {
              "color": "#000 !important"
            },
            ".btn-next .btn .mbr-iconfont-btn": {
              "display": "inline-block",
              "width": "22px",
              "height": "22px",
              "color": "#ffa800",
              "font-size": "15px !important",
              "font-weight": "700",
              "padding": "4px 0px 0px 2px",
              "background": "black",
              "border-radius": "3px"
            },
            "a.title-link, a.title-link:hover, a.title-link:visited, a.title-link::after": {
              "color": "#232323!important",
              "transition": "none!important",
              "text-decoration": "none!important",
              "background-size": "0 !important"
            }
          },
          "_name": "content2",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content2\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Columns\" name=\"cardsWidth\">\n            <option value=\"12\">1</option>\n            <option value=\"6\">2</option>\n            <option value=\"4\" selected=\"\">3</option>\n            <option value=\"3\">4</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked=\"\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\">\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"autoSize &amp;&amp; !(showButtons==false &amp;&amp; showCardSubtitle==false &amp;&amp; showCardTitle==false &amp;&amp; showText==false)\">\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked=\"\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked=\"\">\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Subtitle\" checked=\"\">\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked=\"\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked=\"\">\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#fafafa\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#093d5a\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Báo chia sẻ về hội nghị</b><b><br></b><b style=\"font-size: 2.5rem; background-color: initial;\">Nơi Làm Việc Tốt Nhất Việt Nam<sup>®</sup></b></h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Read the recent blog posts about\n                Mobirise</h5>\n        </div>\n        <div class=\"row mt-4\">\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}} active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://vnexpress.net/100-noi-lam-viec-tot-nhat-viet-nam-2025-4966748.html\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-301.jpg\" alt=\"\" title=\"\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://vnexpress.net/100-noi-lam-viec-tot-nhat-viet-nam-2025-4966748.html\" class=\"text-primary title-link\" target=\"_blank\"><b>100 Nơi Làm Việc Tốt Nhất Việt Nam 2025</b></a></h5>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"https://vnexpress.net/100-noi-lam-viec-tot-nhat-viet-nam-2025-4966748.html\" class=\"text-primary\" target=\"_blank\">https://vnexpress.net/</a></b></h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">Bảng xếp hạng 2025 nổi bật với nhiều doanh nghiệp thăng hạng, loạt gương mặt mới như KienlongBank, Duy Tân Recycling và lần đầu mở rộng khảo sát sang 7.000 sinh viên.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-7\"><a href=\"https://vnexpress.net/100-noi-lam-viec-tot-nhat-viet-nam-2024-4817978.html\" class=\"btn item-btn btn-warning\" target=\"_blank\" data-app-placeholder=\"Type Text\"><span class=\"mbrib-right mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 20px; color: rgb(0, 0, 0);\"></span>\n                            </a></div>\n                </div>\n            </div>\n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://tphcm.chinhphu.vn/cong-bo-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-101251120085426125.htm\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-31.jpg\" alt=\"\" title=\"\" data-slide-to=\"1\" data-bs-slide-to=\"1\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://tphcm.chinhphu.vn/cong-bo-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-101251120085426125.htm\" class=\"text-primary title-link\" target=\"_blank\"><b>Công bố 100 Nơi làm việc tốt nhất Việt Nam năm 2025</b></a></h5>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><a href=\"https://tphcm.chinhphu.vn/cong-bo-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-101251120085426125.htm\" class=\"text-primary\" target=\"_blank\">https://tphcm.chinhphu.vn/</a></h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">(Chinhphu.vn) - Tối 19/11, Anphabe (đơn vị tư vấn tiên phong về giải pháp thương hiệu nhà tuyển dụng và môi trường làm việc hạnh phúc) cùng sự bảo trợ bởi Liên đoàn Thương mại và Công nghiệp Việt Nam (VCCI) và kiểm chứng bởi công ty nghiên cứu thị trường Intage Việt Nam đã chính thức công bố kết quả Bảng xếp hạng (BXH) được mong chờ Top 100 Nơi làm việc tốt nhất Việt Nam 2025.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-7\"><a href=\"https://cafebiz.vn/cac-sep-ab-inbev-va-aeon-doi-tri-the-nao-voi-nhom-nhan-vien-cai-gi-cung-chay-di-hoi-sep-cho-phep-ho-noi-ra-su-that-ma-khong-so-bi-ghet-176241125155315848.chn\" class=\"btn item-btn btn-warning\" target=\"_blank\" data-app-placeholder=\"Type Text\"><span class=\"mbrib-right mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 20px; color: rgb(0, 0, 0);\"></span>\n                            </a></div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://thanhnien.vn/top-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-doanh-nghiep-nao-dung-dau-185251119145854729.htm\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/press-321.jpg\" alt=\"\" title=\"\" data-slide-to=\"2\" data-bs-slide-to=\"2\"></a>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><a href=\"https://thanhnien.vn/top-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-doanh-nghiep-nao-dung-dau-185251119145854729.htm\" class=\"text-primary title-link\" target=\"_blank\"><b>Top 100 nơi làm việc tốt nhất Việt Nam năm 2025, doanh nghiệp nào đứng đầu?</b></a></h5>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\"><b><a href=\"https://thanhnien.vn/top-100-noi-lam-viec-tot-nhat-viet-nam-nam-2025-doanh-nghiep-nao-dung-dau-185251119145854729.htm\" class=\"text-primary\" target=\"_blank\">https://thanhnien.vn/</a></b></h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">Bảng xếp hạng tôn vinh top 100 nơi làm việc tốt nhất Việt Nam ở khối doanh nghiệp lớn và top 100 nơi làm việc tốt nhất Việt Nam ở khối doanh nghiệp vừa.<br>\n                        </p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-7\"><a href=\"https://tuoitre.vn/khao-sat-65-000-nguoi-di-lam-74-noi-thu-nhap-hien-tai-khong-du-chi-tieu-20241204175720065.htm#content-1\" class=\"btn item-btn btn-warning\" target=\"_blank\" data-app-placeholder=\"Type Text\"><span class=\"mbrib-right mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 20px; color: rgb(0, 0, 0);\"></span>\n                            </a></div>\n                </div>\n            </div>\n            \n\n            <div class=\"d-none col-12 view-more align-center text-center\" mbr-buttons=\"\" mbr-theme-style=\"display-4\"><a class=\"btn btn-warning\" href=\"#\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>XEM THÊM</a></div>\n\n        </div>\n        \n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <div class=\"align-center btn-next\" mbr-buttons=\"\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-warning txcolor\" href=\"https://vietnambestplacestowork.com/goc-bao-chi/index.html\" data-app-placeholder=\"Type Text\" target=\"_blank\"><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>XEM THÊM</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
