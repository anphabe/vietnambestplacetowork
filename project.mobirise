          "_name": "info3",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"info3\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"20\" step=\"1\" value=\"13\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"3\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg-cover-1440x774.png\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#232323\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-12 col-lg-10\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-center\">\n                    <div>\n                          <img class=\"logo-award pb-md-3 pb-2\" src=\"@PROJECT_PATH@/assets/images/noi-lam-viec-tot-nhat-vietnam-2020.jpg\" alt=\"Top 100 Nơi làm việc tốt nhất Việt Nam 2020\">\n                        </div>\n                        <h4 class=\"card-title mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-box\"><b>Top 100 Nơi làm việc tốt nhất Việt Nam 2020</b></h4>\n                        <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-box .mbr-text, .mbr-section-btn\">\n                            2500+ beautiful website blocks, templates and themes help you start easily.</p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove, -mbrBtnRemove\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-warning\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Tải danh sách</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "tllUb1lRy9",
          "_anchor": "info3-1g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "witsec-code-editor/components",
          "_isSecondary": true,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".form-control": {
              "line-height": "1.2rem !important"
            },
            ".bptw, .form-select": {
              "font-family": "'Mulish', sans-serif"
            },
            ".ranking-item:nth-child(even) .card": {
              "background-color": "#ededed !important"
            }
          },
          "_name": "witsec-html-block",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section class=\"mbr-section mbr-section--no-padding\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <!-- Place your own code below -->\n    <div class=\"container bptw\">\n        <div class=\"row justify-content-between pb-2 pb-md-4\">\n            <div class=\"col-12 col-md-8\">\n                <input type=\"hidden\" value=\"top100\" id=\"award\">\n                <h3 class=\"h5\" data-app-selector=\".card-box .mbr-text, .mbr-section-btn\">Hạng mục giải thưởng:</h3>\n                <ul data-app-selector=\".card-box .mbr-text, .mbr-section-btn fs-3\">\n                  <li><p class=\"mb-1\"><a href=\"top-100-noi-lam-viec-tot-nhat-viet-nam-2020.html\" class=\"text-success\" style><b>Nơi làm việc tốt nhất Việt Nam</b></a></p></li>\n                  <li><p class=\"mb-1\"><a href=\"top-50-doanh-nghiep-viet-hap-dan-2020.html\" class=\"text-success\">Doanh nghiệp Việt có Thương hiệu nhà tuyển dụng hấp dẫn</a></p></li>\n                  \n                </ul>  \n\n\n            </div>\n            <div class=\"col-12 col-md-4\">\n                <div class=\"row justify-content-end align-items-center\">\n                  <label for=\"select_year\" class=\"col-2 col-form-label text-end p-0\">Năm</label>\n                  <div class=\"col-5\">\n                    <select id=\"select_year\" name=\"select_year\" class=\"form-select mbr-text display-7\">\n                    <option value=\"2025\">2025</option>\n                        <option value=\"2024\">2024</option>\n                        <option value=\"2023\">2023</option>\n                        <option value=\"2022\">2022</option>\n                        <option value=\"2021\">2021</option>\n                        <option value=\"2020\" selected>2020</option>\n                        <option value=\"2018\">2018</option>\n                        <option value=\"2017\">2017</option>\n                        <option value=\"2016\">2016</option>\n                        <option value=\"2015\">2015</option>\n                        <option value=\"2014\">2014</option>\n                        <option value=\"2013\">2013</option>\n                      </select>\n                  </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row justify-content-between \">\n            <div class=\"col-12 col-md-5\">\n                <div class=\"bptw__filter\">\n\n                    <select id=\"select_industry\" name=\"select_industry\" class=\"form-select form-select-lg mb-3 mbr-text\" aria-label=\".form-select-lg\">\n                      <option value selected>Xếp hạng theo ngành</option>\n                      <option value=\"10001000\">Advertising/ Media/ Entertainment</option>\n                      <option value=\"10002000\">Agriculture/ Forestry/ Fisheries</option>\n                      <option value=\"10005100\">Banking</option>\n                      <option value=\"10005200\">Financial Services (Investment, Accounting, Auditing,\n                          Securities, ...)</option>\n                      <option value=\"10006200\">Construction/ Materials/ Architecture (Contractors,\n                          Builder, Construction Manager, …)</option>\n                      <option value=\"10006300\">Materials Manufacturing (Mining, Industrial,\n                          Construction, etc.)</option>\n                      <option value=\"10008000\">Electronics/ Hi-tech/ Utilities</option>\n                      <option value=\"10009000\">Engineering/ Machinery/ Mechanicals</option>\n                      <option value=\"10011000\">Consumer Goods (FMCG Food &amp; Non-food)</option>\n                      <option value=\"10014100\">Hospitality (Hotel, Resorts, Restaurants, Theme park,\n                          …)</option>\n                      <option value=\"10014200\">Tourisms/ Airline</option>\n                      <option value=\"10015100\">Manufacturing/ Chemicals</option>\n                      <option value=\"10016000\">Insurance</option>\n                      <option value=\"10019000\">Hardware Technology/ Infrastructure/ Telecom</option>\n                      <option value=\"10020100\">IT/ Software &amp; Application/ E-commerce</option>\n                      <option value=\"10021100\">Education/ Training/ Consulting</option>\n                      <option value=\"10024000\">Pharmaceutical/ Medical equipment/ Healthcare Services\n                      </option>\n                      <option value=\"10025100\">Real estate/ Real estate services (Developer,\n                          Management service, ...)</option>\n                      <option value=\"10026000\">Retail/ Wholesale/ Trading</option>\n                      <option value=\"10027000\">Transportation/ Logistics (Import, Export, Freight\n                          &amp; forwarding, Express services)</option>\n                    </select>\n               \n                    \n                </div>\n            </div>\n            <div class=\"col-12 col-md-2\">\n              <div class=\"text-md-end\">\n                      <span id=\"bptw-view-grid\" title=\"View grid\" mbr-icon class=\"p-2 mbr-iconfont mbrib-extension\" style=\"font-size: 25px; color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                      <span id=\"bptw-view-table\" title=\"View list\" mbr-icon class=\"p-2 mbr-iconfont mbrib-bulleted-list\" style=\"font-size: 25px; color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n              </div>\n            </div>\n\n\n            <div class=\"col-12 pt-2\" id=\"vnbptw-ranking\">\n              <div id=\"loading-data\" class=\"text-center pt-5\">\n\n                  <div class=\"spinner-border text-align-center\" role=\"status\">\n                    <span class=\"visually-hidden\">Loading...</span>\n                  </div>\n              </div>\n            </div>\n\n        </div>\n    </div>\n    <!-- Place your own code above -->\n\n\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "tllUb1BNSE",
