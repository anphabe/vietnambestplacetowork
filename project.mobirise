              "padding-left": "1rem",
              "padding-right": "1rem",
              "background-color": "#093d5a",
              "min-height": "10vh"
            },
            ".plan-title": {
              "color": "#ffffff"
            },
            ".plan .list-group-item": {
              "position": "relative",
